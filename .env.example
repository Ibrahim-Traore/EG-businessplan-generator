# ── Anthropic ─────────────────────────────────────────────────────────────────
# Clé API principale — générer sur platform.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Claude Managed Agents (CMA) ───────────────────────────────────────────────
# Généré automatiquement par : node setup-cma.js
CMA_ENV_ID=env_...
CMA_AGENT_CADRAGE_T1=agt_...
CMA_AGENT_CADRAGE_T2=agt_...
CMA_AGENT_ANALYSTE_MARCHE=agt_...
CMA_AGENT_MODELE_ECONOMIQUE=agt_...
CMA_AGENT_MODELE_FINANCIER=agt_...
CMA_AGENT_AUDIT_FINAL=agt_...
CMA_AGENT_REDACTEUR=agt_...

# ── Perplexity (optionnel — recherche externe) ────────────────────────────────
# Requis uniquement si l'agent Analyste marché doit effectuer des recherches web
# Clé API sur perplexity.ai/settings/api
PPLX_API_KEY=pplx-...
# Modèle par défaut (peut être omis)
PPLX_MODEL=llama-3.1-sonar-large-128k-online

# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=3131
