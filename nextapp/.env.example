# ── Base de données PostgreSQL ────────────────────────────────────────────────
# Créer une base sur neon.tech (ou autre PostgreSQL), puis coller la connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Authentification NextAuth ────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
AUTH_SECRET=your-secret-here
# URL de l'application (http://localhost:3131 en dev, URL Vercel en prod)
NEXTAUTH_URL=http://localhost:3131

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Clé API — générer sur platform.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Claude Managed Agents (CMA) ───────────────────────────────────────────────
# Généré par : node scripts/setup-cma.js
CMA_ENV_ID=env_...
CMA_AGENT_CADRAGE_T1=agent_...
CMA_AGENT_CADRAGE_T2=agent_...
CMA_AGENT_ANALYSTE_MARCHE=agent_...
CMA_AGENT_MODELE_ECONOMIQUE=agent_...
CMA_AGENT_MODELE_FINANCIER=agent_...
CMA_AGENT_AUDIT_FINAL=agent_...
CMA_AGENT_REDACTEUR=agent_...

# ── Perplexity (optionnel) ────────────────────────────────────────────────────
# PPLX_API_KEY=pplx-...
